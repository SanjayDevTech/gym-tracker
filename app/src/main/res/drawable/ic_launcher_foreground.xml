<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a dumbbell, on the diagonal, white on Foodprint's ink tile — the two
  icons read as a pair. ic_launcher_monochrome.xml and ic_splash.xml carry the same paths; keep
  them in step. Scaled 0.6: on the diagonal that gives the same visual margin as Foodprint's bowl.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centre (54,54) ← rotate −45° and scale 0.6 ← the dumbbell drawn level around (54,70). -->
    <group android:translateX="54" android:translateY="54">
        <group android:rotation="-45" android:scaleX="0.6" android:scaleY="0.6">
            <group android:translateX="-54" android:translateY="-70">
                <path android:fillColor="@android:color/white" android:pathData="M27.5,57 h6 a3.5,3.5 0 0 1 3.5,3.5 v19 a3.5,3.5 0 0 1 -3.5,3.5 h-6 a3.5,3.5 0 0 1 -3.5,-3.5 v-19 a3.5,3.5 0 0 1 3.5,-3.5 Z" />
                <path android:fillColor="@android:color/white" android:pathData="M38,61 h1 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z" />
