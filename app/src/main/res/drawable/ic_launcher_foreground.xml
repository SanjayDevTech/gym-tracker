                <path android:fillColor="@android:color/white" android:pathData="M69,61 h1 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z" />
                <path android:fillColor="@android:color/white" android:pathData="M74.5,57 h6 a3.5,3.5 0 0 1 3.5,3.5 v19 a3.5,3.5 0 0 1 -3.5,3.5 h-6 a3.5,3.5 0 0 1 -3.5,-3.5 v-19 a3.5,3.5 0 0 1 3.5,-3.5 Z" />
