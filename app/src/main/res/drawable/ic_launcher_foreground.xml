<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground, concept A.
  Loaded barbell, side-on, in volt: a 4dp bar (the rule) carrying two plates a side.
  Drawn group is scaled 0.92 about the centre, so the farthest corner sits ~24dp out (48dp keyline).
  Extents x:27..81, y:38..70; farthest corner 25.6dp from centre, inside the 33dp safe-zone radius.
  Colour: @color/ic_launcher_foreground (volt, "work done"). Flat; no gradient or shadow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Bar: full-width 4dp rule -->
        <path
            android:fillColor="@color/ic_launcher_foreground"
            android:pathData="M28,52 h52 a1,1 0 0 1 1,1 v2 a1,1 0 0 1 -1,1 h-52 a1,1 0 0 1 -1,-1 v-2 a1,1 0 0 1 1,-1 Z" />

        <!-- Left big plate 6x32 -->
        <path
            android:fillColor="@color/ic_launcher_foreground"
            android:pathData="M35.5,38 h3 a1.5,1.5 0 0 1 1.5,1.5 v29 a1.5,1.5 0 0 1 -1.5,1.5 h-3 a1.5,1.5 0 0 1 -1.5,-1.5 v-29 a1.5,1.5 0 0 1 1.5,-1.5 Z" />

        <!-- Left small plate 4x20 -->
        <path
            android:fillColor="@color/ic_launcher_foreground"
            android:pathData="M42.25,44 h1 a1.5,1.5 0 0 1 1.5,1.5 v17 a1.5,1.5 0 0 1 -1.5,1.5 h-1 a1.5,1.5 0 0 1 -1.5,-1.5 v-17 a1.5,1.5 0 0 1 1.5,-1.5 Z" />

        <!-- Right small plate -->
        <path
            android:fillColor="@color/ic_launcher_foreground"
            android:pathData="M64.75,44 h1 a1.5,1.5 0 0 1 1.5,1.5 v17 a1.5,1.5 0 0 1 -1.5,1.5 h-1 a1.5,1.5 0 0 1 -1.5,-1.5 v-17 a1.5,1.5 0 0 1 1.5,-1.5 Z" />

        <!-- Right big plate -->
        <path
            android:fillColor="@color/ic_launcher_foreground"
            android:pathData="M69.5,38 h3 a1.5,1.5 0 0 1 1.5,1.5 v29 a1.5,1.5 0 0 1 -1.5,1.5 h-3 a1.5,1.5 0 0 1 -1.5,-1.5 v-29 a1.5,1.5 0 0 1 1.5,-1.5 Z" />
    </group>
